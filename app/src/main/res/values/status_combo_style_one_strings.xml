<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="status_combo_style_one_category">Three-in-One Icon Style One</string>
    <string name="status_combo_style_one_preview">Icon preview</string>
    <string name="status_combo_style_one_preview_summary">The preview uses the same drawing code as the status-bar icon.</string>
    <string name="status_combo_style_one_enable">Enable trio icon</string>
    <string name="status_combo_style_one_enable_summary">Master switch. Turn off to restore the stock battery and signal icons.</string>
    <string name="status_combo_style_one_style">Trio style</string>
    <string name="status_combo_style_one_style_summary">Choose the ring or rectangular layout. The rectangular layout places signal columns on each side and a battery bar across the bottom.</string>
    <string name="status_combo_style_one_style_ring">Battery ring</string>
    <string name="status_combo_style_one_style_rect">Rounded rectangle</string>
    <string name="status_combo_style_one_overlay">Draw in its own window</string>
    <string name="status_combo_style_one_overlay_summary">Draw the glyph in its own window so it is not clipped to the status-bar row height. Turn off to draw inside the bar again.</string>
    <string name="status_combo_style_one_show_wifi">Show Wi-Fi arcs</string>
    <string name="status_combo_style_one_show_wifi_summary">Draw the Wi-Fi arcs; the number of arcs follows the actual Wi-Fi signal level.</string>
    <string name="status_combo_style_one_show_mobile">Show mobile dots</string>
    <string name="status_combo_style_one_show_mobile_summary">Draw four signal dots for the current data SIM, or both SIM levels when dual-SIM display is enabled.</string>
    <string name="status_combo_style_one_show_value">Show battery number</string>
    <string name="status_combo_style_one_show_value_summary">Show the battery percentage inside the ring. Centre it independently from the charging bolt if preferred.</string>
    <string name="status_combo_style_one_show_bolt">Show charging bolt</string>
    <string name="status_combo_style_one_show_bolt_summary">Draw the charging bolt while charging. Its size and horizontal/vertical position can be adjusted under Geometry.</string>
    <string name="status_combo_style_one_value_centred">Center the battery number</string>
    <string name="status_combo_style_one_value_centred_summary">Place the percentage in the ring centre and keep the top notch for Wi-Fi arcs, charging bolt, or network type according to the active state.</string>
    <string name="status_combo_style_one_mobile_type_mode">Network type label</string>
    <string name="status_combo_style_one_mobile_type_mode_summary">Choose whether to hide the network type, place it inside the ring, or draw it outside the glyph.</string>
    <string name="status_combo_style_one_mobile_type_off">Off</string>
    <string name="status_combo_style_one_mobile_type_inside">Inside the icon</string>
    <string name="status_combo_style_one_mobile_type_outside">Outside the icon</string>
    <string name="status_combo_style_one_signal_mode">Signal position</string>
    <string name="status_combo_style_one_signal_mode_summary">Choose whether the mobile signal is drawn inside the ring or outside the glyph.</string>
    <string name="status_combo_style_one_signal_inside">Inside the icon</string>
    <string name="status_combo_style_one_signal_outside">Outside the icon</string>
    <string name="status_combo_style_one_dual_sim">Dual-SIM signal</string>
    <string name="status_combo_style_one_dual_sim_summary">With no Wi-Fi and not charging, show SIM 1 and SIM 2 as two rows. If only one SIM is available, show the current data SIM.</string>
    <string name="status_combo_style_one_stacked_signal">Draw signal bars outside the icon</string>
    <string name="status_combo_style_one_stacked_signal_summary">When the signal is outside the ring, draw four bars and a row of dots for the second SIM. Turn off to keep the system's native mobile icon.</string>
    <string name="status_combo_style_one_data_sim_only">Show only the default data SIM</string>
    <string name="status_combo_style_one_data_sim_only_summary">Use the signal level from the SIM currently selected for mobile data.</string>
