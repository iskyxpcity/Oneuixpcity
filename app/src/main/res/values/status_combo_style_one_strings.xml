    <string name="status_combo_style_one_feature_name">Three-in-One Icon Style One</string>
    <string name="status_combo_style_one_preview">Icon preview</string>
    <string name="status_combo_style_one_preview_summary">Compare charging, low-battery and critical colors on dark and light status-bar backgrounds.</string>
    <string name="status_combo_style_one_preview_charging_dark">Charge · dark</string>
    <string name="status_combo_style_one_preview_charging_light">Charge · light</string>
    <string name="status_combo_style_one_preview_low_dark">Low · dark</string>
    <string name="status_combo_style_one_preview_low_light">Low · light</string>
    <string name="status_combo_style_one_preview_critical_dark">Critical · dark</string>
    <string name="status_combo_style_one_preview_critical_light">Critical · light</string>
    <string name="status_combo_style_one_enable">Enable trio icon</string>
    <string name="status_combo_style_one_enable_summary">Master switch. Turn off to restore the stock battery and signal icons.</string>
    <string name="status_combo_style_one_style">Trio layout</string>
    <string name="status_combo_style_one_style_summary">Choose the trio arrangement. The ring is the default; the rectangle places signal columns on both sides and a battery bar across the bottom.</string>
    <string name="status_combo_style_one_style_ring">Battery ring</string>
    <string name="status_combo_style_one_style_rect">Rounded rectangle</string>
    <string name="status_combo_style_one_overlay">Draw in its own window</string>
    <string name="status_combo_style_one_overlay_summary">Draw the glyph in its own window so it is not clipped to the status-bar row height. Turn off to draw inside the bar again.</string>
    <string name="status_combo_style_one_show_wifi">Show Wi-Fi arcs</string>
    <string name="status_combo_style_one_show_wifi_summary">Draw Wi-Fi arcs at the top of the icon; the arc count follows the actual Wi-Fi signal level. Turn off to restore the stock Wi-Fi icon.</string>
    <string name="status_combo_style_one_show_mobile">Show mobile dots</string>
    <string name="status_combo_style_one_show_mobile_summary">Draw four signal dots at the bottom for the current data SIM. Turn off to restore the stock mobile-signal icon.</string>
    <string name="status_combo_style_one_show_value">Show battery number</string>
    <string name="status_combo_style_one_show_value_summary">Show the battery percentage inside the ring; while charging, the bolt replaces the number. When off, the native charging bolt is restored.</string>
    <string name="status_combo_style_one_show_bolt">Show charging bolt</string>
    <string name="status_combo_style_one_show_bolt_summary">Show the in-ring charging bolt. This setting depends on the battery-number switch; when off, Android\'s native charging bolt is restored.</string>
    <string name="status_combo_style_one_charging_display">Charging display</string>
    <string name="status_combo_style_one_charging_display_summary">Charging color takes priority over low and critical colors. Choose the bolt only, or alternate the bolt and battery number every 5 seconds.</string>
    <string name="status_combo_style_one_charging_display_bolt">Charging bolt only</string>
    <string name="status_combo_style_one_charging_display_alternate">Alternate bolt and battery number every 5 seconds</string>
    <string name="status_combo_style_one_value_centred">Center the battery number</string>
    <string name="status_combo_style_one_value_centred_summary">Enlarge the battery percentage and keep it in the ring centre. Available only for the ring layout while Wi-Fi arcs and the battery number are enabled.</string>
    <string name="status_combo_style_one_mobile_type_mode">Network type label</string>
    <string name="status_combo_style_one_mobile_type_mode_summary">Choose whether to hide the network type, place it inside the ring, or draw it outside the glyph.</string>
    <string name="status_combo_style_one_mobile_type_off">Off</string>
    <string name="status_combo_style_one_mobile_type_inside">Inside the icon</string>
    <string name="status_combo_style_one_mobile_type_outside">Outside the icon</string>
    <string name="status_combo_style_one_signal_mode">Signal position</string>
    <string name="status_combo_style_one_signal_mode_summary">Choose where mobile signal is drawn. Inside uses the icon\'s bottom dots; outside moves the reading beside the battery and uses the stacking option below to choose its shape.</string>
    <string name="status_combo_style_one_signal_inside">Inside the icon</string>
    <string name="status_combo_style_one_signal_outside">Outside the icon</string>
    <string name="status_combo_style_one_dual_sim">Dual-SIM signal</string>
    <string name="status_combo_style_one_dual_sim_summary">Choose whether to show dual-SIM signal dots inside the ring or in two rows below it. If both SIM levels are unavailable, the icon falls back to the active data SIM.</string>
    <string name="status_combo_style_one_dual_sim_off">Off</string>
    <string name="status_combo_style_one_dual_sim_ring_vertical">Top and bottom of ring</string>
    <string name="status_combo_style_one_dual_sim_below_ring">Below ring</string>
    <string name="status_combo_style_one_stacked_signal">Draw signal bars outside the icon</string>
    <string name="status_combo_style_one_stacked_signal_summary">When signal is placed outside the ring, draw ascending bars for one SIM and dots for the other. Turn off to restore the stock mobile icon.</string>
    <string name="status_combo_style_one_data_sim_only">Show only the default data SIM</string>
    <string name="status_combo_style_one_data_sim_only_summary">Use the signal level from the SIM currently selected for mobile data.</string>
