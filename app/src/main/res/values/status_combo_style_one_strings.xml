    <string name="status_combo_style_one_signal_dot_spacing_summary">Current %1$d dp: centre-to-centre spacing of horizontal ring signal dots at 100%% overall size.</string>
    <string name="status_combo_style_one_signal_dot_offset_x">Dot horizontal offset</string>
    <string name="status_combo_style_one_signal_dot_offset_x_summary">Current %1$d dp: shift ring signal dots horizontally; positive values move right.</string>
    <string name="status_combo_style_one_signal_dot_offset_y">Dot vertical offset</string>
    <string name="status_combo_style_one_signal_dot_offset_y_summary">Current %1$d dp: shift ring signal dots vertically; positive values move down.</string>
