    <string name="status_combo_style_one_ring_stroke_rect">Battery bar thickness</string>
    <string name="status_combo_style_one_ring_stroke_summary">Current %1$d: thickness of the battery-ring outline.</string>
    <string name="status_combo_style_one_ring_stroke_summary_rect">Current %1$d: thickness of the battery bar along the bottom.</string>
    <string name="status_combo_style_one_arc_stroke_summary">Current %1$d: stroke width of the Wi-Fi arcs.</string>
    <string name="status_combo_style_one_arc_stroke_summary_rect">Current %1$d: Wi-Fi arc stroke width and vertical position inside the top slot.</string>
    <string name="status_combo_style_one_value_size_summary">Current %1$d sp: battery percentage text size. Centered mode can enlarge the centre value up to 1.4×.</string>
    <string name="status_combo_style_one_value_weight_summary">Current weight %1$d: 100 is thinnest and 900 is heaviest.</string>
    <string name="status_combo_style_one_type_size_summary">Current %1$d: size of the network type inside the ring; available only when placement is Inside.</string>
    <string name="status_combo_style_one_out_type_size_summary">Current %1$d dp: size of the network-type label outside the icon; available only when placement is Outside.</string>
    <string name="status_combo_style_one_type_suffix_scale_summary">Current %1$d%%: scale of the trailing A in labels such as 5GA. Applies both inside and outside.</string>
    <string name="status_combo_style_one_out_type_margin_left_summary">Current %1$d dp: left gap around the outside network-type label.</string>
    <string name="status_combo_style_one_out_type_margin_right_summary">Current %1$d dp: right gap around the outside network-type label.</string>
    <string name="status_combo_style_one_type_weight_summary">Current weight %1$d: 100 is thinnest and 900 is heaviest; available when a network-type label is shown.</string>
    <string name="status_combo_style_one_out_signal_size_summary">Current %1$d dp: overall height of the outside signal reading. Requires mobile signal, Outside placement and stacked signal.</string>
    <string name="status_combo_style_one_out_signal_margin_summary">Current %1$d dp: adjusts the gap between the battery ring and the outside signal bars or network-type label; it does not resize the glyphs. Requires stacked outside signal.</string>
    <string name="status_combo_style_one_track_alpha_summary">Current %1$d%%: opacity of inactive arcs and signal graphics.</string>
    <string name="status_combo_style_one_bolt_size_summary">Current %1$d%%: scale of the charging bolt; requires both the battery number and charging bolt to be enabled.</string>
    <string name="status_combo_style_one_bolt_x_summary">Current %1$d dp: horizontal position of the charging bolt; positive values move right.</string>
    <string name="status_combo_style_one_bolt_y_summary">Current %1$d dp: vertical position of the charging bolt; positive values move down.</string>
    <string name="status_combo_style_one_glyph_offset_x_summary">Current %1$d dp: horizontal position of the entire composite icon; positive values move right.</string>
    <string name="status_combo_style_one_glyph_offset_y_summary">Current %1$d dp: vertical position of the entire composite icon; positive values move down.</string>
    <string name="status_combo_style_one_glyph_left_margin_summary">Current %1$d dp: reserve spacing on the left of the composite icon.</string>
    <string name="status_combo_style_one_glyph_right_margin_summary">Current %1$d dp: reserve spacing on the right of the composite icon.</string>
