    <string name="version_updates_title">Version Highlights</string>
    <string name="version_1_0_260930_title">1.0.260930 · First Release</string>
    <string name="version_1_0_260930_summary">An introduction to the main features included in the first release.</string>
    <string name="version_1_0_261013_title">Aloha OneUI 1.0.261013 Highlights</string>
    <string name="version_1_0_261013_summary">2026-10-13</string>
    <string name="version_1_0_261018_title">Aloha OneUI 1.0.261018 Highlights</string>
    <string name="version_1_0_261018_summary">2026-10-18</string>
    <string name="version_1_0_261016_title">Aloha OneUI 1.0.261016 Highlights</string>
    <string name="version_1_0_261016_summary">2026-10-16</string>
    <string name="changelog_261018_device_status_title">Home device status card</string>
    <string name="changelog_261018_device_status_body">Added an expandable card that brings together system monitoring, screen details and device information.</string>
    <string name="changelog_261018_cpu_frequency_title">Live CPU frequency</string>
    <string name="changelog_261018_cpu_frequency_body">CPU monitoring now shows current clock frequencies by core, arranged in a stable grid.</string>
    <string name="changelog_261018_live_metrics_title">System and battery monitoring</string>
    <string name="changelog_261018_live_metrics_body">Added memory and storage usage, battery level, voltage and temperature, with animated wave indicators.</string>
    <string name="changelog_261018_version_statusbar_title">Display and status bar fixes</string>
    <string name="changelog_261018_version_statusbar_body">Fixed One UI version formatting and improved status bar layout stability and burn-in protection.</string>
    <string name="changelog_261016_statusbar_stability_title">Status bar layout stability</string>
    <string name="changelog_261016_statusbar_stability_body">Fixed a Samsung One UI fold/unfold issue where the empty native status-icon container reported fluctuating widths, making the network-speed text jump left briefly and return.</string>
    <string name="changelog_261016_burnin_title">Status bar burn-in protection</string>
    <string name="changelog_261016_burnin_body">Added burn-in protection for status-bar elements drawn by Aloha OneUI. It applies a gentle, slow X/Y micro-shift to reduce the risk of the same pixels displaying static content for long periods. Open Status bar → Other → Status bar burn-in protection to enable or disable it and adjust the movement amplitude (0–2 dp) and cycle period (10–300 seconds).</string>
    <string name="changelog_261013_feature_intro_title">Feature introduction</string>
    <string name="changelog_261013_feature_intro_body">Added the Feature Introduction entry and version update pages.</string>
    <string name="changelog_261013_dual_ui_title">Two interface styles</string>
    <string name="changelog_261013_dual_ui_body">Version lists and details now follow the Material and Miuix interface styles.</string>
    <string name="changelog_261013_version_split_title">Separate version notes</string>
    <string name="changelog_261013_version_split_body">1.0.261013 and 1.0.260930 each open their own update notes.</string>
    <string name="changelog_section_combo_title">Three-in-one status bar icon</string>
    <string name="changelog_section_combo_body">Combine the battery ring, mobile signal, network type and Wi-Fi state in one customizable status-bar indicator. Adjust its size, position, spacing and colors, with support for dual SIM/eSIM presentation and charging or power-saving states.</string>
    <string name="changelog_section_statusbar_title">Status bar appearance</string>
    <string name="changelog_section_statusbar_body">Customize the status-bar clock and other indicators, including text style, color, size, weight, background, position and spacing.</string>
    <string name="changelog_section_network_title">Network indicators</string>
    <string name="changelog_section_network_body">Configure status-bar network speed, Wi-Fi, cellular signal and network-type indicators to make the information display fit your preferences.</string>
    <string name="changelog_section_power_title">Real-time power information</string>
    <string name="changelog_section_power_body">Configure status-bar fields for power consumption, current, battery temperature, CPU temperature, voltage and battery level, including the displayed items, layout, text size and spacing.</string>
    <string name="changelog_section_ui_title">Two app interface styles</string>
    <string name="changelog_section_ui_body">Choose between Miuix and Material in Settings. Theme appearance also includes light/dark mode and accent-color options.</string>
    <string name="changelog_section_diagnostics_title">Settings and diagnostics</string>
    <string name="changelog_section_diagnostics_body">Feature categories are organized across the main pages of Aloha OneUI. Use Settings → Send log to export runtime diagnostics when troubleshooting module behavior or status-bar display issues.</string>

    <string name="nav_rail_expand">Expand navigation rail</string>
    <string name="nav_rail_collapse">Collapse navigation rail</string>
    <string name="feature_intro_version_updates_261025">Aloha OneUI 1.0.261025 Highlights</string>
    <string name="feature_intro_version_updates_261025_summary">2026-10-25</string>
    <string name="version_1_0_261025_title">Aloha OneUI 1.0.261025 Highlights</string>
    <string name="version_1_0_261025_summary">2026-10-25</string>
    <string name="changelog_261025_theme_store_region_title">Theme Store region switching</string>
    <string name="changelog_261025_theme_store_region_body">Added a region selector for the Theme Store so users can choose the store region they want to browse.</string>
    <string name="changelog_261025_floating_ball_docking_title">Floating ball edge docking fix</string>
    <string name="changelog_261025_floating_ball_docking_body">Fixed automatic edge docking after moving the floating ball, while preserving its configured trigger actions and size.</string>
    <string name="changelog_261025_button_states_title">Consistent selection button states</string>
    <string name="changelog_261025_button_states_body">Unified selected and unselected option-button styles with the three-button style used on Theme Settings. The Miuix Home device-status selector retains its previous appearance.</string>
    <string name="changelog_261025_theme_store_ui_title">Theme Store presentation improvements</string>
    <string name="changelog_261025_theme_store_ui_body">Refined the Theme Store region-switching entry and kept Material and Miuix presentation aligned with each theme’s native components.</string>
    <string name="feature_intro_version_updates_261023">Aloha OneUI 1.0.261023 Highlights</string>
    <string name="feature_intro_version_updates_261023_summary">2026-10-23</string>
    <string name="feature_intro_version_updates_2610191">Aloha OneUI 1.0.261019.1 Highlights</string>
    <string name="feature_intro_version_updates_2610191_summary">2026-10-19</string>
    <string name="version_1_0_261023_title">Aloha OneUI 1.0.261023 Highlights</string>
    <string name="version_1_0_261023_summary">2026-10-23</string>
    <string name="changelog_261023_rename_title">Official rename</string>
    <string name="changelog_261023_rename_body">The project has officially been renamed to Aloha OneUI.</string>
    <string name="changelog_261023_global_shortcuts_title">Global shortcut actions</string>
    <string name="changelog_261023_global_shortcuts_body">Where to find it: on the app’s main screen, open the third navigation tab, “Features,” then select “Global shortcut actions” near the bottom of that page (next to “Other functions”). It brings together global three-finger gestures, the floating ball, status-bar shortcuts, virtual navigation-key shortcuts, and screen-off volume-key actions.</string>
    <string name="changelog_261023_shortcut_triggers_title">Supported trigger types</string>
    <string name="changelog_261023_shortcut_triggers_body">• Global three-finger actions: swipe up, down, left, or right; pinch in; and spread out, each with its own action.\n• Floating ball: configure color, size, haptic feedback, single tap, double tap, and four directional swipes.\n• Status bar: double tap, tap the upper-left or upper-right corner, and long press.\n• Virtual navigation keys: double-tap and long-press actions for Back, Home, and Recents.\n• Screen-off volume keys: long-press to change tracks and double-click to play / pause while the screen is off; normal volume-key behavior is retained while the screen is on.</string>
    <string name="changelog_261023_shortcut_actions_title">Available actions</string>
    <string name="changelog_261023_shortcut_actions_body">• Default: No action.\n• System: Back, Home, Recents, Screenshot, Smart Screenshot, Turn screen off, Power menu, Kill foreground app, and Memory cleanup.\n• Camera / recording: Take photo, Video, and Screen recording.\n• Media: Previous track, Next track, Play / pause, Rewind, and Fast-forward.\n• Quick toggles: Flashlight, Airplane mode, Bluetooth, Silent mode, Vibrate mode, Wi-Fi, and Mobile data.\n• Quick payment: WeChat Scan, WeChat Pay, WeChat Collect, Alipay Scan, Alipay Pay, and Alipay Collect.\n• Custom: choose an installed app to launch.</string>
    <string name="changelog_261023_shortcut_sync_title">Sync and activation requirements</string>
    <string name="changelog_261023_shortcut_sync_body">After changing a toggle, action, or parameter, settings are saved and you are prompted “Sync now?”. Choosing “Sync now” applies the changes to the module; “Later” leaves the edits unapplied for now. Before enabling, make sure the LSPosed scopes include android / System Framework; virtual navigation-key actions work only with three-button navigation and also require the SystemUI scope.</string>
    <string name="changelog_261023_qs_seconds_title">Quick panel clock seconds</string>
    <string name="changelog_261023_qs_seconds_body">Fixed seconds display in the pull-down Quick Settings panel.</string>
    <string name="version_1_0_2610191_title">Aloha OneUI 1.0.261019.1 Highlights</string>
    <string name="version_1_0_2610191_summary">2026-10-19</string>
    <string name="changelog_2610191_new_features_title">New features</string>
    <string name="changelog_2610191_new_features_body">• Customizable power menu with configurable actions and ordering.\n• Disable screenshot sounds.\n• Call-return delay setting from 0–5 seconds.\n• Dual-pane layout option for System Settings.\n• Allow installation of older-version apps.\n• Remove secure-window screenshot restrictions.\n• Disable post-install app recommendations.\n• Soft-restart options for SystemUI and Android Runtime.</string>
    <string name="changelog_2610191_optimizations_title">Improvements</string>
    <string name="changelog_2610191_optimizations_body">• Refined status-bar combo icon layout and native icon spacing.\n• Improved native signal icon display and restoration behavior.\n• Improved persistence and migration of icon-scaling settings.\n• Better Material, Miuix and wide-screen layout adaptation.</string>
    <string name="changelog_2610191_fixes_title">Fixes</string>
    <string name="changelog_2610191_fixes_body">• Fixed abnormal icon-scale ratios during some settings migrations.\n• Fixed leftover blank space that could remain after hiding native icons.\n• Improved configuration reading and compatibility for some system functions.</string>
    <string name="alohaoneui_global_shortcut_actions_title">全局快捷动作</string>
    <string name="alohaoneui_global_shortcut_actions_summary">配置全局三指手势、悬浮球、状态栏、虚拟导航键和息屏音量键的快捷操作。</string>
