<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Preserve the complete 108dp adaptive-icon viewport. -->
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <color android:color="@android:color/transparent" />
    </item>
    <!-- Keep Logo001 well inside the One UI adaptive-mask safe area. -->
    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_launcher_foreground_logo001"
            android:gravity="fill" />
    </item>
</layer-list>
