    <string name="status_combo_style_one_enable">启用三合一图标</string>
    <string name="status_combo_style_one_enable_summary">总开关。关闭后恢复系统原本的电池与信号图标。</string>
    <string name="status_combo_style_one_style">三合一样式</string>
    <string name="status_combo_style_one_style_summary">选择三合一的排布方式。圆环是默认样式；矩形改用左右两列信号点夹住中间内容，底部横贯一条电量条。</string>
    <string name="status_combo_style_one_style_ring">圆环</string>
    <string name="status_combo_style_one_style_rect">矩形</string>
    <string name="status_combo_style_one_overlay">独立窗口绘制</string>
    <string name="status_combo_style_one_overlay_summary">把三合一画在一个独立的小窗口里，不再受状态栏窗口高度（约 43dp）限制，图标可以完整显示；代价是图形下半部分会露在状态栏背景之外。关闭后回到状态栏内绘制。</string>
    <string name="status_combo_style_one_show_wifi">显示 Wi-Fi 弧</string>
    <string name="status_combo_style_one_show_wifi_summary">在最外层绘制 Wi-Fi 弧线，弧数跟随实际信号强度；关闭后原生 Wi-Fi 图标回到状态栏原本的位置。</string>
    <string name="status_combo_style_one_show_mobile">显示移动信号点</string>
    <string name="status_combo_style_one_show_mobile_summary">在底部绘制四个电平点表示移动网络信号强度；关闭后原生移动信号图标回到状态栏原本的位置。</string>
    <string name="status_combo_style_one_show_value">显示电量数字</string>
    <string name="status_combo_style_one_show_value_summary">在环内显示电量百分比；充电时按「充电显示方式」只显示闪电，或每 5 秒交替显示闪电与电量数字。电量数字居中模式下不进行轮替。关闭后，原生充电闪电同样交还系统显示。</string>
    <string name="status_combo_style_one_show_bolt">充电时显示闪电</string>
    <string name="status_combo_style_one_show_bolt_summary">关闭后不再用环内闪电，改由系统原生的充电闪电显示在电池图标旁。</string>
    <string name="status_combo_style_one_charging_display">充电显示方式</string>
    <string name="status_combo_style_one_charging_display_summary">充电颜色优先于低电量和危险电量颜色。可仅显示闪电，或每 5 秒轮替显示闪电与电量数字；当电量数字位于圆环开口时，同样遵循此设置。</string>
    <string name="status_combo_style_one_charging_display_bolt">充电闪电</string>
    <string name="status_combo_style_one_charging_display_alternate">闪电数字</string>
    <string name="status_combo_style_one_value_centred">电量数字居中</string>
    <string name="status_combo_style_one_value_centred_summary">电量数字放大到圆环中间并始终优先占据圆心。Wi-Fi 弧缩到顶部缺口，充电时改用小的闪电占用缺口（此时不画 Wi-Fi 弧），环内的网络类型也让位到缺口。</string>
    <string name="status_combo_style_one_mobile_type_mode">网络类型</string>
    <string name="status_combo_style_one_mobile_type_mode_summary">选择网络类型文字的显示位置：关闭、圆环内，或在状态栏中另外绘制一个。</string>
    <string name="status_combo_style_one_mobile_type_off">关闭</string>
    <string name="status_combo_style_one_mobile_type_inside">环内</string>
    <string name="status_combo_style_one_mobile_type_outside">环外</string>
    <string name="status_combo_style_one_signal_mode">信号位置</string>
    <string name="status_combo_style_one_signal_mode_summary">选择移动信号读数的位置。环内沿用图标底部的电平点；环外则把它挪到电池图标旁，按下面的堆叠开关决定怎么显示。</string>
    <string name="status_combo_style_one_signal_inside">环内</string>
    <string name="status_combo_style_one_signal_outside">环外</string>
    <string name="status_combo_style_one_dual_sim">双卡信号</string>
    <string name="status_combo_style_one_dual_sim_summary">选择双卡信号点的显示位置：关闭、圆环上下或圆环底下。两张卡的信号均可读取时显示双卡信号；否则回退到当前上网卡。</string>
    <string name="status_combo_style_one_dual_sim_off">关闭</string>
    <string name="status_combo_style_one_dual_sim_ring_vertical">圆环上下</string>
    <string name="status_combo_style_one_dual_sim_below_ring">圆环底下</string>
    <string name="status_combo_style_one_stacked_signal">堆叠信号</string>
    <string name="status_combo_style_one_stacked_signal_summary">环外时自己绘制读数：四条高度递增的柱表示一张卡，下方一排圆点表示另一张卡；只有一张卡时只画柱。关闭则沿用系统原生的移动信号图标。</string>
    <string name="status_combo_style_one_data_sim_only">仅显示上网卡</string>
    <string name="status_combo_style_one_data_sim_only_summary">双卡时只绘制当前上网卡的读数，另一张卡不显示。单卡或读不到上网卡时不受影响。</string>
