    <string name="status_combo_style_one_style_rect">圆角矩形</string>
    <string name="status_combo_style_one_overlay">在独立窗口绘制</string>
    <string name="status_combo_style_one_overlay_summary">在独立窗口绘制，避免图标被状态栏行的高度裁切。关闭后改为在状态栏内部绘制。</string>
    <string name="status_combo_style_one_show_wifi">显示 Wi-Fi 弧线</string>
    <string name="status_combo_style_one_show_wifi_summary">绘制 Wi-Fi 弧线，弧线数量会跟随实际 Wi-Fi 信号等级。</string>
    <string name="status_combo_style_one_show_mobile">显示移动信号点</string>
    <string name="status_combo_style_one_show_mobile_summary">显示当前数据 SIM 的四格信号点；启用双卡显示后可显示两张卡的等级。</string>
    <string name="status_combo_style_one_show_value">显示电量数字</string>
    <string name="status_combo_style_one_show_value_summary">在圆环内显示电量百分比；可单独调整数字居中方式，不影响充电闪电开关。</string>
    <string name="status_combo_style_one_show_bolt">显示充电闪电</string>
    <string name="status_combo_style_one_show_bolt_summary">充电时显示闪电，可在“几何”页单独调整大小和水平/垂直位置。</string>
    <string name="status_combo_style_one_value_centred">电量数字居中</string>
    <string name="status_combo_style_one_value_centred_summary">将电量百分比放在圆环中央；顶部缺口根据当前状态容纳 Wi-Fi 弧线、充电闪电或网络类型。</string>
