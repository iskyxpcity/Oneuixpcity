    <string name="status_combo_style_one_preview">图标预览</string>
    <string name="status_combo_style_one_preview_summary">对比充电、低电量和危险电量在深色与浅色状态栏背景下的显示效果。</string>
    <string name="status_combo_style_one_preview_charging_dark">充电·深</string>
    <string name="status_combo_style_one_preview_charging_light">充电·浅</string>
    <string name="status_combo_style_one_preview_low_dark">低电·深</string>
    <string name="status_combo_style_one_preview_low_light">低电·浅</string>
    <string name="status_combo_style_one_preview_critical_dark">危险·深</string>
