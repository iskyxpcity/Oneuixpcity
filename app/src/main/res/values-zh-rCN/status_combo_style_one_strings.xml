    <string name="status_combo_style_one_enable">启用三合一图标</string>
    <string name="status_combo_style_one_enable_summary">将电量、Wi-Fi 弧线、移动信号与网络类型组合为一个状态栏图标。</string>
    <string name="status_combo_style_one_style">三合一样式</string>
    <string name="status_combo_style_one_style_summary">选择三合一的排布方式。圆环是默认样式；矩形使用两侧信号柱夹住中间内容，底部横贯一条电量条。</string>
    <string name="status_combo_style_one_style_ring">电量圆环</string>
    <string name="status_combo_style_one_style_rect">圆角矩形</string>
    <string name="status_combo_style_one_overlay">在独立窗口绘制</string>
    <string name="status_combo_style_one_overlay_summary">在独立窗口绘制，避免图标被状态栏行的高度裁切。关闭后改为在状态栏内部绘制。</string>
    <string name="status_combo_style_one_show_wifi">显示 Wi-Fi 弧线</string>
    <string name="status_combo_style_one_show_wifi_summary">在图标顶部绘制 Wi-Fi 弧线，弧线数量随实际 Wi-Fi 信号强度变化；关闭后恢复系统原生 Wi-Fi 图标。</string>
    <string name="status_combo_style_one_show_mobile">显示移动信号点</string>
    <string name="status_combo_style_one_show_mobile_summary">在图标底部绘制四个信号点表示当前上网卡的移动信号强度；关闭后恢复系统原生移动信号图标。</string>
    <string name="status_combo_style_one_show_value">显示电量数字</string>
    <string name="status_combo_style_one_show_value_summary">在圆环内显示电量百分比；充电时由闪电替代数字。关闭后，原生充电闪电也交还给系统显示。</string>
    <string name="status_combo_style_one_show_bolt">显示充电闪电</string>
    <string name="status_combo_style_one_show_bolt_summary">充电时显示圆环内的闪电。此选项依赖「显示电量数字」；关闭后恢复系统原生充电闪电。</string>
    <string name="status_combo_style_one_charging_display">充电显示方式</string>
    <string name="status_combo_style_one_charging_display_summary">充电颜色优先于低电量和危险电量颜色。可仅显示闪电，或每 5 秒轮替显示闪电与电量数字。</string>
    <string name="status_combo_style_one_charging_display_bolt">充电闪电</string>
    <string name="status_combo_style_one_charging_display_alternate">闪电数字</string>
    <string name="status_combo_style_one_value_centred">电量数字居中</string>
    <string name="status_combo_style_one_value_centred_summary">将电量百分比放大并固定在圆环中央。仅圆环样式且 Wi-Fi 弧线和电量数字均开启时可用；顶部缺口为 Wi-Fi 弧线或充电状态留出空间。</string>
    <string name="status_combo_style_one_mobile_type_mode">网络类型标签</string>
    <string name="status_combo_style_one_mobile_type_mode_summary">选择隐藏网络类型、在圆环内显示，或在图标外侧显示。</string>
    <string name="status_combo_style_one_mobile_type_off">关闭</string>
    <string name="status_combo_style_one_mobile_type_inside">图标内部</string>
    <string name="status_combo_style_one_mobile_type_outside">图标外侧</string>
    <string name="status_combo_style_one_signal_mode">信号位置</string>
    <string name="status_combo_style_one_signal_mode_summary">选择移动信号读数的位置。环内使用图标底部的信号点；环外时将读数移至电池图标旁，由下方堆叠选项决定显示方式。</string>
    <string name="status_combo_style_one_signal_inside">图标内部</string>
    <string name="status_combo_style_one_signal_outside">图标外侧</string>
    <string name="status_combo_style_one_dual_sim">双 SIM 信号</string>
    <string name="status_combo_style_one_dual_sim_summary">选择双 SIM 信号点的显示位置：圆环上下或圆环底下。若无法读取两张卡的信号，则回退到当前上网卡。</string>
    <string name="status_combo_style_one_dual_sim_off">关闭</string>
    <string name="status_combo_style_one_dual_sim_ring_vertical">圆环上下</string>
    <string name="status_combo_style_one_dual_sim_below_ring">圆环底下</string>
    <string name="status_combo_style_one_stacked_signal">圆环外信号柱</string>
    <string name="status_combo_style_one_stacked_signal_summary">信号位置选择为图标外侧时，使用四条递增信号柱显示一张卡，并以点阵显示另一张卡；可在下方调整信号柱与圆环的间距，关闭后恢复系统原生移动信号图标。</string>
    <string name="status_combo_style_one_data_sim_only">只显示默认数据 SIM</string>
    <string name="status_combo_style_one_data_sim_only_summary">使用当前被选为移动数据卡的 SIM 信号强度。</string>
