    <string name="status_combo_style_one_enable">启用三合一图标</string>
    <string name="status_combo_style_one_enable_summary">将电量、Wi-Fi 弧线、移动信号与网络类型组合为一个状态栏图标。</string>
    <string name="status_combo_style_one_style">三合一图标样式</string>
    <string name="status_combo_style_one_style_summary">选择圆环或矩形排布。矩形排布会在两侧显示信号柱，并在底部显示电量条。</string>
