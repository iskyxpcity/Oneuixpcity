    <string name="status_combo_style_one_sp_summary">当前 %1$d sp</string>
    <string name="status_combo_style_one_value_size_summary">当前 %1$d sp：电量百分比文字的大小。开启「电量数字居中」时，圆心数字最多放大至原字号的 1.4 倍。</string>
    <string name="status_combo_style_one_value_weight_summary">当前字重 %1$d：100 最细，900 最粗。</string>
    <string name="status_combo_style_one_type_size_summary">当前 %1$d：圆环中间 3G/4G/5G 等网络类型文字的大小。仅选择「图标内部」时可调整。</string>
    <string name="status_combo_style_one_out_type_size_summary">当前 %1$d dp：状态栏中环外网络类型标签的大小；仅选择「图标外侧」时可调整。</string>
    <string name="status_combo_style_one_type_suffix_scale_summary">当前 %1$d%%：网络类型以 A 结尾（如 5GA）时，末尾 A 相对主字号的比例；环内、环外标签共用此设置。</string>
    <string name="status_combo_style_one_out_type_margin_left_summary">当前 %1$d dp：环外网络类型标签左侧留白，仅在网络类型显示于图标外侧时生效。</string>
    <string name="status_combo_style_one_out_type_margin_right_summary">当前 %1$d dp：环外网络类型标签右侧留白，仅在网络类型显示于图标外侧时生效。</string>
    <string name="status_combo_style_one_type_weight_summary">当前字重 %1$d：100 最细，900 最粗；仅显示网络类型文字时可调整。</string>
    <string name="status_combo_style_one_out_signal_size_summary">当前 %1$d dp：环外信号读数的整体高度。只有开启移动信号、选择环外位置并启用堆叠信号后才可调整。</string>
    <string name="status_combo_style_one_out_signal_margin_summary">当前 %1$d dp：只控制环外信号布局间距。只显示环外信号柱时，调整信号柱与圆环的间距；同时显示图标外网络类型时，调整信号图形与网络类型标签之间的间距。网络类型标签与圆环的间距在“网络类型”分类单独设置。</string>
    <string name="status_combo_style_one_out_type_ring_gap_summary">当前 %1$d dp：只调整图标外网络类型标签与电量圆环之间的间距，不改变“环外信号”分类的间距值。</string>
    <string name="status_combo_style_one_track_alpha_summary">当前 %1$d%%：控制未点亮的弧线与信号图形的透明度。</string>
    <string name="status_combo_style_one_bolt_size_summary">当前 %1$d%%：充电时闪电的缩放比例；需要同时开启电量数字和充电闪电。</string>
