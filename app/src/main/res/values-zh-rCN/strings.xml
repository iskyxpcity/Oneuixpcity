    <string name="version_1_0_261013_summary">2026-10-13</string>
    <string name="changelog_261013_feature_intro_title">功能入口</string>
    <string name="changelog_261013_feature_intro_body">新增「功能介绍」入口与版本更新页面。</string>
    <string name="changelog_261013_dual_ui_title">双主题适配</string>
    <string name="changelog_261013_dual_ui_body">版本列表和更新详情适配 Material、Miuix 两套界面。</string>
    <string name="changelog_261013_version_split_title">分版本查看</string>
    <string name="changelog_261013_version_split_body">1.0.261013 与 1.0.260930 分别显示对应更新内容。</string>
    <string name="changelog_section_combo_title">三合一状态栏组合图标</string>
    <string name="changelog_section_combo_body">将电量圆环、移动信号、网络类型和 Wi-Fi 状态整合到一个可自定义的状态栏图标中。可调整图标大小、位置、间距和颜色，并支持双 SIM/eSIM 显示，以及充电、快充和省电状态的视觉效果。</string>
    <string name="changelog_section_statusbar_title">状态栏外观自定义</string>
    <string name="changelog_section_statusbar_body">支持自定义状态栏时间及其他指示图标，可调整文字样式、颜色、大小、粗细、背景、位置和间距。</string>
    <string name="changelog_section_network_title">网络状态指示</string>
    <string name="changelog_section_network_body">提供状态栏网速、Wi-Fi、蜂窝信号及网络类型相关设置，让状态栏信息显示更符合个人习惯。</string>
    <string name="changelog_section_power_title">实时功耗信息</string>
    <string name="changelog_section_power_body">支持配置状态栏功耗、电流、电池温度、CPU 温度、电压和电量等信息项，并可调整显示项目、布局、文字大小与间距。</string>
    <string name="changelog_section_ui_title">两套应用界面风格</string>
    <string name="changelog_section_ui_body">可在设置中选择 Miuix 或 Material 两套界面风格，并可配置浅色/深色模式和强调色等外观选项。</string>
    <string name="changelog_section_diagnostics_title">设置与运行诊断</string>
    <string name="changelog_section_diagnostics_body">应用各主要页面按功能分类组织设置。遇到模块运行或状态栏显示问题时，可通过「设置 → 发送日志」导出运行诊断信息，便于排查。</string>

