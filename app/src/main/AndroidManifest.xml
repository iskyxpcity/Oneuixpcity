<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <queries>
        <!-- Make every launchable app visible to the custom global-shortcut action picker. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="org.lsposed.manager" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.systemui" />
        <package android:name="com.samsung.android.app.notes" />
        <package android:name="com.samsung.android.app.sketchbook" />
        <package android:name="com.samsung.android.app.watchmanager" />
        <package android:name="com.samsung.android.calendar" />
        <package android:name="com.samsung.android.da.daagent" />
        <package android:name="com.samsung.android.dialer" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.samsung.android.service.airviewdictionary" />
        <package android:name="com.samsung.android.shealthmonitor" />
        <package android:name="com.samsung.android.themecenter" />
        <package android:name="com.samsung.android.video" />
        <package android:name="com.sec.android.app.camera" />
        <package android:name="com.sec.android.app.launcher" />
        <package android:name="com.sec.android.app.samsungapps" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.sec.android.daemonapp" />
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.sec.android.mimage.photoretouching" />
    </queries>

    <application
        android:name=".AlohaOneUIApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:directBootAware="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher_aloha"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlohaOneUI">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Aloha OneUI · independent feature module" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.StartupActivity"
            android:exported="true"
            android:theme="@style/Theme.AlohaOneUI.Startup" />
        <activity-alias
            android:name=".ui.StartupActivityThemed"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_aloha"
            android:label="@string/app_name"
            android:targetActivity=".ui.StartupActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.StartupActivityStatic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_aloha_static"
            android:label="@string/app_name"
            android:targetActivity=".ui.StartupActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AlohaOneUI"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
